<script>
window.addEventListener('keydown', (e) => {
  if (e.shiftKey && e.altKey && e.code === 'KeyC') {
    e.preventDefault();
    if (!confirm('Wipe? Clears bt_*, session, #s=, ?s=, ?game=, ?invite= and reloads clean')) return;
    try { window.btChannel?.close(); } catch {}
    try {
      for (let i = localStorage.length-1; i>=0; i--) {
        const k = localStorage.key(i);
        if (k?.startsWith('bt_')) localStorage.removeItem(k);
      }
      localStorage.clear();
    } catch {}
    try { sessionStorage.clear(); } catch {}
    try {
      const u = new URL(location.href);
      u.search = '';
      u.hash = '';
      history.replaceState(null,'', u.href);
    } catch {
      location.hash = '';
      location.search = '';
    }
    location.reload();
  }
});
window.addEventListener('storage', (ev) => {
  if (ev.key === 'bt_owner' && ev.newValue === null) location.reload();
});
</script>
</script>
</body>
</html>
